# Where instance data (config.json + ratings/*.md) is stored. Point this at a
# mounted volume when self-hosting.
DATA_DIR=./data

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: enables "Sign in with GitHub" on the admin login page.
# Create an OAuth App at https://github.com/settings/developers with
# callback URL <your-domain>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
